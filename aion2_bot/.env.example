# Copy this file to ".env" and fill in your values. NEVER commit the real .env.
#
# DISCORD_BOT_TOKEN: required. From the Discord Developer Portal
# (Applications → your bot → Bot → Reset Token). Treat it like a password.
DISCORD_BOT_TOKEN=paste-your-bot-token-here

# AION2_DB: optional path for the database file (default: aion2.db next to bot.py).
AION2_DB=

# DISCORD_GUILD_ID: optional, for development. Your server's ID makes slash
# commands appear instantly instead of after Discord's up-to-an-hour global sync.
DISCORD_GUILD_ID=
