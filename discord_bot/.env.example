# Copy this file to ".env" and fill in your values. NEVER commit the real .env.
#
# 1. DISCORD_BOT_TOKEN — required. Get it from the Discord Developer Portal
#    (see README.md, "Step 1"). This is a SECRET; treat it like a password.
DISCORD_BOT_TOKEN=paste-your-bot-token-here

# 2. DISCORD_GUILD_ID — optional, for development only. Set it to your test
#    server's ID so new slash commands appear instantly instead of after
#    Discord's ~1 hour global sync. Leave blank for production.
DISCORD_GUILD_ID=
